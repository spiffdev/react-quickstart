# Environment variables for SpiffCommerce
# These are only used during local development and are supplied dynamically when the theme is deployed.
VITE_APPLICATION_KEY=INSERT_SPIFFCOMMERCE_APPLICATION_KEY
VITE_HUB_URL=https://hub.au.spiffcommerce.com
VITE_SERVER_URL=https://moonlight.au.spiffcommerce.com
VITE_SERVICES_URL=https://services.au.spiffcommerce.com
# The base URL of the editor, which hosts the mobile upload page the QR code links to.
# Defaults to https://app.au.spiffcommerce.com. Set this to point at another editor, including a localhost one.
VITE_EDITOR_URL=https://app.au.spiffcommerce.com
# The ID of the Activation to use during local development. This is required for the theme to correctly run.
VITE_ACTIVATION_ID=INSERT_SPIFFCOMMERCE_ACTIVATION_ID
# Optional, for activations in single product mode. In production the e-commerce product page that launched the theme
# supplies the integration product, which selects the product to personalise (skipping the product selection page).
# Set this to test that. The integration product must belong to a collection of the activation.
VITE_INTEGRATION_PRODUCT_ID=


# Any additional variables you need.
# Remember you'll need to include these in the build if they're required at runtime.
